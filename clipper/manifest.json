{
  "manifest_version": 3,
  "name": "Mindstone Web Clipper",
  "version": "1.0.0",
  "description": "Save a page, a selection, or a simplified article into the Mindstone desktop app on this computer.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": { "default_popup": "popup.html", "default_title": "Clip to Mindstone", "default_icon": { "128": "icon-128.png" } },
  "icons": { "128": "icon-128.png" }
}

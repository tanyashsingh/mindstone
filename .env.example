# REA needs no environment variables to build or run.
# AI provider keys are entered in Settings -> AI providers and stored encrypted (Windows DPAPI).
# Never put real keys in this file.

# Optional, development only: load the Electron shell from the Vite dev server.
# REA_DEV_URL=http://localhost:5183

# Optional, packaging only: skip automatic code-signing certificate discovery.
# CSC_IDENTITY_AUTO_DISCOVERY=false

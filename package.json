{
  "name": "mindstone",
  "productName": "Mindstone",
  "version": "0.4.0",
  "description": "Mindstone: a local-first, privacy-first workspace for notes, tasks, databases, voice and knowledge.",
  "private": true,
  "license": "UNLICENSED",
  "author": "Mindstone",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:web": "node scripts/ocr-setup.mjs && vite build && node scripts/prune-dist.mjs",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:electron",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "check:all": "npm run typecheck && npm test && npm run test:e2e",
    "test:desktop": "npm run build && playwright test -c playwright.electron.config.ts",
    "logo": "node scripts/render-logo.mjs",
    "voice:setup": "node scripts/voice-setup.mjs",
    "postinstall": "node scripts/ocr-setup.mjs",
    "ocr:setup": "node scripts/ocr-setup.mjs",
    "test:pwa": "npm run build:web && playwright test -c playwright.pwa.config.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@floating-ui/dom": "^1.8.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@noble/ciphers": "^2.4.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.35.0",
    "@tiptap/extension-details": "^3.35.0",
    "@tiptap/extension-highlight": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-list": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "dompurify": "^3.5.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.8",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.80.0",
    "marked": "^18.3.0",
    "mermaid": "^12.3.0",
    "minisearch": "^7.2.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "build": {
    "appId": "app.cairn.workspace",
    "productName": "Mindstone",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "artifactName": "Mindstone-Setup-${version}.${ext}",
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "tanyashsingh",
      "repo": "mindstone",
      "releaseType": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    },
    "asar": true,
    "extraResources": [
      {
        "from": "clipper",
        "to": "clipper"
      }
    ]
  },
  "allowScripts": {
    "onnxruntime-node": false,
    "protobufjs": false
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
